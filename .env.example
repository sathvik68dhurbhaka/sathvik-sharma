# ==========================================
# AI STUDY MANAGER - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Student & Admin Sessions
JWT_SECRET=ai-study-manager-production-jwt-secret-replace-in-prod-2026

# ------------------------------------------
# AI PROVIDER CONFIGURATION
# ------------------------------------------
# Gemini API Key (Recommended)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI-compatible Provider Fallback
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# CLOUD FIRESTORE / FIREBASE (OPTIONAL FOR CLOUD DEPLOYMENT)
# Note: In local development, the application automatically uses the integrated
# persistent data store located in server/data/db.json without requiring credentials.
# ------------------------------------------
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
